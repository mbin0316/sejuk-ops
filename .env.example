# Copy to .env.local (never committed) and fill in.

# ---- Front-end (exposed to the browser, VITE_ prefix) ----
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://sejuk-ops/api
# Shared demo-account password shown in the reviewers' notice on the sign-in page (public on the site; keep it out of git)
VITE_DEMO_PASSWORD=

# ---- Server only (Vercel env vars / local API) ----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://sejuk-ops/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# AI assistant (optional; without a key it uses keyword rules and templates).
# Groq is used if GROQ_API_KEY is set (model: GROQ_MODEL, default openai/gpt-oss-120b), else Claude via ANTHROPIC_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
